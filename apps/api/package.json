{
  "name": "@sourcewiki/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src prisma.config.ts --max-warnings=0",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@sourcewiki/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jose": "^6.1.3",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/nodemailer": "^7.0.5",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "prisma": "7.8.0",
    "supertest": "^7.1.0",
    "tsx": "^4.21.0"
  }
}
