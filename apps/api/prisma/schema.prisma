generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(320)
  passwordHash    String    @map("password_hash")
  nickname        String    @db.VarChar(30)
  bio             String?   @db.VarChar(500)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  verificationTokens EmailVerificationToken[]
  refreshSessions    RefreshSession[]
  sources            Source[]
  comments           Comment[]
  sourceLikes        SourceLike[]
  uploadedFiles      UploadedFile[]

  @@map("users")
}

enum SourceType {
  article
  docs
  paper
  github
  other

  @@map("source_type")
}

enum ExtractionStatus {
  not_requested
  succeeded
  failed

  @@map("extraction_status")
}

enum SummaryStatus {
  not_requested
  succeeded
  failed
  demo

  @@map("summary_status")
}

model Source {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  title            String           @db.VarChar(200)
  originalUrl      String           @map("original_url") @db.VarChar(2048)
  sourceDomain     String           @map("source_domain") @db.VarChar(253)
  sourceType       SourceType       @default(other) @map("source_type")
  rawText          String?          @map("raw_text")
  rawTextPreview   String?          @map("raw_text_preview") @db.VarChar(300)
  summary          String?
  keyPoints        Json             @default("[]") @map("key_points") @db.JsonB
  keywords         Json             @default("[]") @db.JsonB
  personalNote     String?          @map("personal_note")
  extractionStatus ExtractionStatus @default(not_requested) @map("extraction_status")
  summaryStatus    SummaryStatus    @default(not_requested) @map("summary_status")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  comments         Comment[]
  sourceTags       SourceTag[]
  sourceLikes      SourceLike[]
  uploadedFiles    UploadedFile[]

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId])
  @@map("sources")
}

model SourceLike {
  userId    String   @map("user_id") @db.Uuid
  sourceId  String   @map("source_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([userId, sourceId])
  @@index([sourceId])
  @@index([userId, createdAt])
  @@map("source_likes")
}

model UploadedFile {
  id           String   @id @default(uuid()) @db.Uuid
  sourceId     String   @map("source_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  originalName String   @map("original_name") @db.VarChar(255)
  storedName   String   @unique @map("stored_name") @db.VarChar(120)
  mimeType     String   @map("mime_type") @db.VarChar(120)
  sizeBytes    Int      @map("size_bytes")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  source       Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([sourceId, createdAt])
  @@index([userId])
  @@map("uploaded_files")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  sourceId  String   @map("source_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([sourceId, createdAt, id])
  @@index([userId])
  @@map("comments")
}

model Tag {
  id             String      @id @default(uuid()) @db.Uuid
  name           String      @db.VarChar(30)
  normalizedName String      @unique @map("normalized_name") @db.VarChar(30)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  sourceTags     SourceTag[]

  @@map("tags")
}

model SourceTag {
  sourceId String @map("source_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([sourceId, tagId])
  @@index([tagId])
  @@map("source_tags")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model RefreshSession {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  familyId     String          @map("family_id") @db.Uuid
  tokenHash    String          @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime        @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?       @map("revoked_at") @db.Timestamptz(3)
  replacedById String?         @unique @map("replaced_by_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy   RefreshSession? @relation("SessionRotation", fields: [replacedById], references: [id])
  replaces     RefreshSession? @relation("SessionRotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("refresh_sessions")
}
